const liveTokenRateLimits = new Map<string, { count: number; resetAt: number }>();

app.post("/api/live/token", async (req: Request, res: Response) => {
  const now = Date.now();
  const clientIp = req.ip || req.socket.remoteAddress || "unknown";
  let bucket = liveTokenRateLimits.get(clientIp);

  if (!bucket || bucket.resetAt <= now) {
    bucket = { count: 0, resetAt: now + 60_000 };
    liveTokenRateLimits.set(clientIp, bucket);
  }

  if (bucket.count >= 8) {
    res.setHeader("Retry-After", String(Math.ceil((bucket.resetAt - now) / 1000)));
    res.status(429).json({ error: "Too many Live token requests. Please try again shortly." });
    return;
  }
  bucket.count += 1;

  if (liveTokenRateLimits.size > 1000) {
    for (const [ip, entry] of liveTokenRateLimits) {
      if (entry.resetAt <= now) liveTokenRateLimits.delete(ip);
    }
  }

  try {
    const ai = getGenAIClient("v1alpha");
    const created = await ai.authTokens.create({
      config: {
        uses: 1,
        expireTime: new Date(now + 30 * 60 * 1000).toISOString(),
        newSessionExpireTime: new Date(now + 60 * 1000).toISOString(),
        liveConnectConstraints: {
          model: "gemini-3.8-live",
          config: {
            responseModalities: [Modality.AUDIO],
            speechConfig: {
              voiceConfig: {
                prebuiltVoiceConfig: { voiceName: "Kore" }
              }
            },
            sessionResumption: {},
            systemInstruction:
              "You are JanuAi, a warm, helpful voice assistant. Naturally detect whether the user is speaking Bengali, Hindi, or English and reply in the same language. Keep your spoken replies clear and conversational. Let the user interrupt you naturally; stop your response when the user starts speaking."
          }
        },
        lockAdditionalFields: []
      }
    });

    if (!created.name) {
      throw new Error("Gemini did not return an ephemeral token.");
    }

    res.status(200).json({
      token: created.name,
      expireTime: created.expireTime,
      newSessionExpireTime: created.newSessionExpireTime,
      model: "gemini-3.8-live"
    });
  } catch (error) {
    console.error(
      "Gemini Live token creation failed:",
      error instanceof Error ? error.message : "Unknown error"
    );
    res.status(502).json({
      error: "Gemini Live token could not be created. Check the backend API configuration."
    });
  }
});

// 2. Ultra-Fast Single-Pass Multimodal Voice Turn (Audio -> Transcript + Reply + Phone Action in ~1.3s)
  app.post("/api/assistant/voice-turn", async (req: Request, res: Response) => {
    try {
      const {
        audioBase64,
        mimeType = "audio/webm",
        preferredLanguage = "bn",
        history = [],
        memories = [],
        contacts = [],
        deviceState = {},
      } = req.body as {
        audioBase64?: string;
        mimeType?: string;
        preferredLanguage?: SupportedLanguage;
        history?: HistoryTurn[];
        memories?: MemoryInput[];
        contacts?: ContactInput[];
        deviceState?: DeviceStateInput;
      };

      if (!audioBase64 || typeof audioBase64 !== "string") {
        res.status(400).json({ error: "ভয়েস অডিও পাওয়া যায়নি।", code: "INVALID_AUDIO" });
        return;
      }

      const prefLang: SupportedLanguage = normalizeLanguageParam(preferredLanguage);
      const ai = getGenAIClient();
      const systemInstruction = buildSystemInstruction(prefLang, memories, contacts, deviceState);
      const contents = buildConversationHistory(history);

      const cleanMime = (mimeType || "audio/webm").split(";")[0].trim() || "audio/webm";
      contents.push({
        role: "user",
        parts: [
          {
            inlineData: {
              mimeType: cleanMime,
              data: audioBase64,
            },
          },
          {
            text:
              "Listen carefully to the user's voice audio (Bengali, Hindi, or English). Transcribe what they said and respond immediately as Janu AI in the exact language spoken.",
          },
        ],
      });

      const response = await ai.models.generateContent({
        model: FAST_CONVERSATION_MODEL,
        contents,
        config: {
          systemInstruction,
          responseMimeType: "application/json",
          responseSchema: structuredTurnSchema,
        },
      });

      const rawJson = (response.text || "{}").trim();
      const parsed = JSON.parse(rawJson) as StructuredTurnOutput;
      const transcript = (parsed.transcript || "").trim();

      if (parsed.heardSpeech === false || !transcript) {
        res.status(200).json({
          heardSpeech: false,
          transcript: "",
          reply: "",
          language: prefLang,
          toolActions: [],
          sources: [],
        });
        return;
      }

      const activeLang: SupportedLanguage =
        parsed.language === "hi" || parsed.language === "bn" || parsed.language === "en"
          ? parsed.language
          : detectActiveLanguage(transcript, prefLang);
      const finalReply =
        (parsed.reply || "").trim() ||
        (activeLang === "hi"
          ? "जी, बताइए मैं कैसे मदद करूँ?"
          : activeLang === "en"
          ? "Yes, how can I help you?"
          : "জি, বলুন কীভাবে সাহায্য করতে পারি?");
      const toolActions = convertStructuredToToolActions(parsed);

      const inlineAudioRequested = (req.body as { inlineFemaleTts?: boolean }).inlineFemaleTts !== false;
      let ttsAudioBase64: string | undefined;
      let audioMimeType: string | undefined;

      // Pre-synthesize female voice inline (~200ms) unless client will override spoken text for contact lookup
      if (inlineAudioRequested && parsed.actionName !== "proposePhoneCall") {
        try {
          ttsAudioBase64 = await synthesizeFastFemaleMp3Base64(finalReply, activeLang);
          audioMimeType = "audio/mpeg";
        } catch {
          // Client will fetch /api/assistant/tts as fallback if needed
        }
      }

      res.status(200).json({
        heardSpeech: true,
        transcript,
        reply: finalReply,
        language: activeLang,
        toolActions,
        sources: [],
        audioBase64: ttsAudioBase64,
        audioMimeType,
      });
    } catch (error) {
      const formatted = formatGeminiError(error);
      res.status(formatted.status).json({
        error: formatted.message,
        code: formatted.code,
      });
    }
  });

  // 3. Ultra-Fast Single-Pass Text Conversational Endpoint (~0.9s)
  app.post("/api/assistant/chat", async (req: Request, res: Response) => {
    try {
      const {
        message,
        preferredLanguage = "bn",
        history = [],
        memories = [],
        contacts = [],
        deviceState = {},
      } = req.body as {
        message?: string;
        preferredLanguage?: SupportedLanguage;
        history?: HistoryTurn[];
        memories?: MemoryInput[];
        contacts?: ContactInput[];
        deviceState?: DeviceStateInput;
      };

      if (!message || typeof message !== "string" || !message.trim()) {
        res.status(400).json({ error: "মেসেজ খালি রাখা যাবে না।", code: "INVALID_INPUT" });
        return;
      }

      const trimmed = message.trim();
      const prefLang: SupportedLanguage = normalizeLanguageParam(preferredLanguage);
      const activeLanguage = detectActiveLanguage(trimmed, prefLang);

      const ai = getGenAIClient();
      const systemInstruction = buildSystemInstruction(
        activeLanguage,
        memories,
        contacts,
        deviceState
      );
      const contents = buildConversationHistory(history);
      contents.push({
        role: "user",
        parts: [{ text: trimmed }],
      });

      const response = await ai.models.generateContent({
        model: FAST_CONVERSATION_MODEL,
        contents,
        config: {
          systemInstruction,
          responseMimeType: "application/json",
          responseSchema: structuredTurnSchema,
        },
      });

      const rawJson = (response.text || "{}").trim();
      const parsed = JSON.parse(rawJson) as StructuredTurnOutput;
      const finalLang: SupportedLanguage =
        parsed.language === "hi" || parsed.language === "bn" || parsed.language === "en"
          ? parsed.language
          : activeLanguage;
      const replyText = (parsed.reply || "").trim();

      if (!replyText) {
        throw new Error("Empty reply from Gemini.");
      }

      const toolActions = convertStructuredToToolActions(parsed);

      const inlineAudioRequested = (req.body as { inlineFemaleTts?: boolean }).inlineFemaleTts !== false;
      let audioBase64: string | undefined;
      let audioMimeType: string | undefined;

      if (inlineAudioRequested && parsed.actionName !== "proposePhoneCall") {
        try {
          audioBase64 = await synthesizeFastFemaleMp3Base64(replyText, finalLang);
          audioMimeType = "audio/mpeg";
        } catch {
          // Client fallback
        }
      }

      res.status(200).json({
        reply: replyText,
        language: finalLang,
        toolActions,
        sources: [],
        audioBase64,
        audioMimeType,
      });
    } catch (error) {
      const formatted = formatGeminiError(error);
      res.status(formatted.status).json({
        error: formatted.message,
        code: formatted.code,
      });
    }
  });

  // 4. Standalone Speech-to-Text Transcription (extracts audioTranscription.text properly)
  app.post("/api/assistant/transcribe", async (req: Request, res: Response) => {
    try {
      const {
        audioBase64,
        mimeType = "audio/webm",
        preferredLanguage = "bn",
      } = req.body as {
        audioBase64?: string;
        mimeType?: string;
        preferredLanguage?: SupportedLanguage;
      };

      if (!audioBase64 || typeof audioBase64 !== "string") {
        res.status(400).json({ error: "Audio payload is missing.", code: "INVALID_AUDIO" });
        return;
      }

      const ai = getGenAIClient();
      const cleanMime = (mimeType || "audio/webm").split(";")[0].trim() || "audio/webm";
      const langHint =
        "Transcribe spoken Bengali (বাংলা), Hindi (हिन्दी), or English accurately in its native script.";

      let transcript = "";
      try {
        const response = await ai.models.generateContent({
          model: TRANSCRIBE_MODEL,
          contents: {
            parts: [
              { inlineData: { mimeType: cleanMime, data: audioBase64 } },
              { text: langHint },
            ],
          },
        });
        transcript = extractTranscribeText(response);
      } catch {
        // Fallback to fast multimodal flash-lite transcription
        const fallback = await ai.models.generateContent({
          model: FAST_CONVERSATION_MODEL,
          contents: {
            parts: [
              { inlineData: { mimeType: cleanMime, data: audioBase64 } },
              { text: `${langHint} Return ONLY the spoken words, or empty string if silent.` },
            ],
          },
        });
        transcript = (fallback.text || "").trim();
      }

      const detectedLanguage = detectActiveLanguage(
        transcript,
        normalizeLanguageParam(preferredLanguage)
      );

      res.status(200).json({
        transcript,
        detectedLanguage,
      });
    } catch (error) {
      const formatted = formatGeminiError(error);
      res.status(formatted.status).json({
        error: formatted.message,
        code: formatted.code,
      });
    }
  });

  // 5. 100% Female-Only Text-to-Speech Endpoint (Fast Female MP3 + Studio Gemini Female Voices)
  app.post("/api/assistant/tts", async (req: Request, res: Response) => {
    try {
      const {
        text,
        voiceName = "Kore",
        language = "bn",
        mode = "fast",
      } = req.body as {
        text?: string;
        voiceName?: string;
        language?: SupportedLanguage;
        mode?: "fast" | "studio";
      };

      if (!text || typeof text !== "string" || !text.trim()) {
        res.status(400).json({ error: "Text is required for TTS.", code: "INVALID_TEXT" });
        return;
      }

      const safeLang: SupportedLanguage = normalizeLanguageParam(language);

      // Super Fast 100% Female MP3 Mode (~180-300ms, never male, zero quota exhaustion)
      if (mode !== "studio") {
        const mp3Base64 = await synthesizeFastFemaleMp3Base64(text.trim(), safeLang);
        res.status(200).json({
          audioBase64: mp3Base64,
          mimeType: "audio/mpeg",
        });
        return;
      }

      // Studio Neural Mode: strictly FEMALE prebuilt voices ONLY ('Kore' or 'Zephyr' — male voices banned)
      const geminiFemaleVoice =
        voiceName === "Zephyr" || voiceName === "PiyaSweet" ? "Zephyr" : "Kore";

      const langLabel =
        safeLang === "hi" ? "Hindi" : safeLang === "en" ? "English" : "Bengali";
      const stylePrompt =
        voiceName === "PiyaSweet"
          ? `Sweet, youthful, cute anime-style ${langLabel} young female voice`
          : voiceName === "PiyaCalm"
          ? `Calm, gentle, soft-spoken ${langLabel} female personal assistant voice`
          : voiceName === "Zephyr"
          ? `Bright, cheerful, energetic young ${langLabel} female voice`
          : `Warm, sweet, natural ${langLabel} female personal assistant voice`;

      const ai = getGenAIClient();
      const studioModels = [TTS_LITE_MODEL, TTS_STUDIO_MODEL];

      for (const ttsModel of studioModels) {
        try {
          const response = await ai.models.generateContent({
            model: ttsModel,
            contents: [
              {
                role: "user",
                parts: [
                  {
                    text: text.trim(),
                    speechMetadata: {
                      style: stylePrompt,
                    },
                  },
                ],
              },
            ],
            config: {
              responseModalities: ["AUDIO"],
              speechConfig: {
                voiceConfig: {
                  prebuiltVoiceConfig: {
                    voiceName: geminiFemaleVoice,
                  },
                },
              },
            },
          });

          const base64Audio = response.candidates?.[0]?.content?.parts?.[0]?.inlineData?.data;
          if (base64Audio) {
            res.status(200).json({
              audioBase64: base64Audio,
              mimeType: "audio/wav",
            });
            return;
          }
        } catch {
          // Try next studio female model or fall back to fast female MP3 below
        }
      }

      // Seamless fallback to Fast 100% Female MP3 if Studio quota (429) is reached — NEVER male!
      const fallbackMp3 = await synthesizeFastFemaleMp3Base64(text.trim(), safeLang);
      res.status(200).json({
        audioBase64: fallbackMp3,
        mimeType: "audio/mpeg",
      });
    } catch (error) {
      const formatted = formatGeminiError(error);
      res.status(formatted.status).json({
        error: formatted.message,
        code: formatted.code,
      });
    }
  });

  // Never allow any /api/* route to fall through to HTML index.html
  app.all("/api/*", (req: Request, res: Response) => {
    res.status(404).json({
      error: `API endpoint not found: ${req.method} ${req.originalUrl}`,
      code: "API_NOT_FOUND",
    });
  });

  // Express JSON error guard for malformed body / payload size errors
  app.use((err: Error, req: Request, res: Response, next: NextFunction) => {
    if (req.path.startsWith("/api/")) {
      res.status(400).json({
        error: err.message || "Invalid API request payload.",
        code: "BAD_REQUEST",
      });
      return;
    }
    next(err);
  });

  // Vite Dev Server or Production Static Assets
  if (process.env.NODE_ENV !== "production") {
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: "spa",
    });
    app.use(vite.middlewares);
  } else {
    const distPath = path.join(__dirname, "dist");
    app.use(express.static(distPath));
    app.get("*", (_req: Request, res: Response) => {
      res.sendFile(path.join(distPath, "index.html"));
    });
  }

  app.listen(PORT, "0.0.0.0", () => {
    console.log(`Janu AI server running on http://0.0.0.0:${PORT}`);
  });
}

startServer();
