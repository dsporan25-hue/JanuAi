function splitTextForFemaleTts(text: string, maxLen = 175): string[] {
  const clean = text.replace(/[*#_`~]/g, "").trim();
  if (!clean) return [];
  const sentences = clean.match(/[^।|.?!]+(?:[।|.?!]+|$)/g) || [clean];
  const chunks: string[] = [];
  let current = "";

  for (const raw of sentences) {
    const s = raw.trim();
    if (!s) continue;
    if ((current + " " + s).trim().length <= maxLen) {
      current = (current + " " + s).trim();
    } else {
      if (current) chunks.push(current);
      if (s.length <= maxLen) {
        current = s;
      } else {
        const words = s.split(/\s+/);
        let sub = "";
        for (const w of words) {
          if ((sub + " " + w).trim().length <= maxLen) {
            sub = (sub + " " + w).trim();
          } else {
            if (sub) chunks.push(sub);
            sub = w;
          }
        }
        current = sub;
      }
    }
  }
  if (current) chunks.push(current);
  return chunks;
}

/**
 * Synthesizes 100% Female Bengali (bn), Hindi (hi), or English (en) MP3 audio in ~150-300ms.
 * Never produces a male voice.
 */
async function synthesizeFastFemaleMp3Base64(
  text: string,
  language: SupportedLanguage
): Promise<string> {
  const chunks = splitTextForFemaleTts(text);
  if (chunks.length === 0) {
    throw new Error("Empty text for speech synthesis.");
  }
  const tl = language === "hi" ? "hi" : language === "en" ? "en" : "bn";
  const buffers = await Promise.all(
    chunks.map(async (segment) => {
      const url = `https://translate.googleapis.com/translate_tts?ie=UTF-8&client=tw-ob&tl=${tl}&q=${encodeURIComponent(
        segment
      )}`;
      const resp = await fetch(url, {
        headers: {
          "User-Agent": "Mozilla/5.0",
        },
      });
      if (!resp.ok) {
        throw new Error(`Fast female TTS failed (${resp.status})`);
      }
      return Buffer.from(await resp.arrayBuffer());
    })
  );
  return Buffer.concat(buffers).toString("base64");
}

function getGenAIClient(apiVersion?: string): GoogleGenAI {
  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey || apiKey === "MY_GEMINI_API_KEY" || apiKey.trim() === "") {
    const err = new Error(
      "GEMINI_API_KEY সেট করা নেই। অনুগ্রহ করে AI Studio-র Settings > Secrets প্যানেলে API key যাচাই করুন।"
    );
    (err as Error & { statusCode?: number }).statusCode = 503;
    throw err;
  }

  return new GoogleGenAI({
    apiKey,
    httpOptions: {
      ...(apiVersion ? { apiVersion } : {}),
      headers: {
        "User-Agent": "aistudio-build",
      },
      timeout: 20000,
    },
  });
}

/**
 * Detects whether user input is Bengali, Hindi, or English, falling back to preferred language.
 */
function detectActiveLanguage(text: string, preferredLanguage: SupportedLanguage): SupportedLanguage {
  const bengaliChars = (text.match(/[\u0980-\u09FF]/g) || []).length;
  const devanagariChars = (text.match(/[\u0900-\u097F]/g) || []).length;

  if (bengaliChars > 0 && bengaliChars >= devanagariChars) {
    return "bn";
  }
  if (devanagariChars > 0 && devanagariChars > bengaliChars) {
    return "hi";
  }

  const lower = text.toLowerCase();
  const romanBengaliMarkers = [
    "kemon",
    "acho",
    "korbo",
    "koro",
    "amar",
    "tumi",
    "bhalo",
    "khobor",
    "kholo",
    "chalao",
    "baja",
    "dako",
    "mone rakho",
    "hyan",
  ];
  const romanHindiMarkers = [
    "kaise",
    "kya",
    "mera",
    "meri",
    "tum",
    "aap",
    "chalao",
    "bajao",
    "lagao",
    "yaad rakho",
    "haan",
    "nahi",
  ];
  const englishMarkers = [
    "what",
    "how",
    "who",
    "where",
    "when",
    "why",
    "please",
    "turn on",
    "turn off",
    "open",
    "call",
    "battery",
    "flashlight",
    "alarm",
    "remember",
    "hello",
    "good morning",
    "good evening",
    "tell me",
    "play",
    "lock",
  ];

  let bnScore = 0;
  let hiScore = 0;
  let enScore = 0;
  for (const w of romanBengaliMarkers) {
    if (lower.includes(w)) bnScore += 1;
  }
  for (const w of romanHindiMarkers) {
    if (lower.includes(w)) hiScore += 1;
  }
  for (const w of englishMarkers) {
    if (lower.includes(w)) enScore += 1;
  }

  if (bnScore > hiScore && bnScore >= enScore && bnScore >= 1) return "bn";
  if (hiScore > bnScore && hiScore >= enScore && hiScore >= 1) return "hi";
  if (enScore >= 1 && bnScore === 0 && hiScore === 0) return "en";

  return preferredLanguage;
}

function normalizeLanguageParam(raw?: string): SupportedLanguage {
  if (raw === "hi") return "hi";
  if (raw === "en") return "en";
  return "bn";
}

